        "@grpc/proto-loader": "^0.8.1",
        "@neodrag/vanilla": "^2.3.1",
        "@vitest/coverage-v8": "4.1.11",
        "ag-grid-community": "^36.1.0",
        "allure-vitest": "3.10.2",
        "axios": "^1.19.0",
        "bumpp": "^12.2.1",
        "chai": "^6.2.2",
        "clipboardy": "^5.3.2",
        "cloudinary": "^2.10.1",
        "colors": "^1.4.0",
        "commander": "^15.0.0",
        "compression": "^1.7.4",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "d3": "^7.9.0",
        "dexie": "^4.4.5",
        "dotenv": "^17.4.2",
        "easymde": "^2.21.0",
        "esbuild": "^0.28.2",
        "escape-string-regexp": "^5.0.0",
        "express": "^5.2.1",
        "express-fileupload": "^1.4.3",
        "express-rate-limit": "^8.6.2",
        "express-slow-down": "^3.1.0",
        "fast-json-stable-stringify": "^2.1.0",
        "favicons": "^7.3.1",
        "fs-extra": "^11.4.0",
        "fullcalendar": "^7.0.2",
        "helmet": "^8.3.0",
        "html-minifier-terser": "^7.2.0",
        "http-proxy-middleware": "^4.2.0",
        "ignore-walk": "^9.0.0",
        "iovalkey": "^0.4.0",
        "json-colorizer": "^3.0.1",
        "js-yaml": "^5.3.0",
        "jsonwebtoken": "^9.0.3",
        "mariadb": "^3.5.3",
        "mongoose": "^9.9.3",
        "marked": "^18.0.10",
        "morgan": "^1.11.0",
        "nodemailer": "^9.0.5",
        "nodemon": "^3.0.1",
        "peer": "^1.0.2",
        "peerjs": "^1.5.5",
        "prom-client": "^15.1.2",
        "read": "^6.0.0",
        "rrule": "^2.8.1",
        "shelljs": "^0.10.0",
        "sitemap": "^9.0.1",
        "socket.io": "^4.8.3",
        "sortablejs": "^1.15.0",
        "split-file": "^2.3.0",
        "swagger-autogen": "^2.23.7",
        "swagger-ui-express": "^5.0.0",
        "typedoc": "^0.28.20",
        "typescript": "6.0.3",
        "validator": "^13.15.35",
        "vanilla-jsoneditor": "^3.13.0",
        "vitest": "4.1.11",
        "winston": "^3.19.0",
        "workbox-background-sync": "^7.4.1",
        "workbox-cacheable-response": "^7.4.1",
        "workbox-core": "^7.4.1",
        "workbox-expiration": "^7.4.1",
        "workbox-precaching": "^7.4.1",
        "workbox-routing": "^7.4.1",
        "workbox-strategies": "^7.4.1"
    }
}