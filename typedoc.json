    "**/api/item-ledger/**",
    "**/api/object-layer-render-frames/**",
    "**/api/object-layer/**",
    "**/client/**",
    "**/docs/**",
    "**/hardhat/**",
    "**/node_modules/**"
  ],
  "out": "./public/www.cyberiaonline.com/docs/",
